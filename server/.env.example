# Argus server config. Copy to .env (gitignored) and fill in — never commit real secrets.
# Values are also read from the process environment if you prefer to export them instead.

# NetBox connection (source of truth)
NETBOX_URL=https://netbox.lan
NETBOX_TOKEN=
NETBOX_VERIFY_SSL=true

# UniFi Network controller (discovery collector — Integration API token)
UNIFI_URL=https://192.168.1.1
UNIFI_API_TOKEN=
# Site to discover (internalReference). Empty, "*", or "all" → discover every site on the
# controller (multi-site, opt-in); any other value → just that one site.
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false

# pfSense/OPNsense firewall (discovery collector — SSH CLI and optional SNMP)
PFSENSE_HOST=192.168.1.1
# Credential patterns:
# - Direct: PFSENSE_USERNAME="admin" (plaintext in env var)
# - File path with JSON key: PFSENSE_USERNAME="~/.secrets/lab-creds:username"
# - Plain file: PFSENSE_USERNAME="~/.secrets/lab-username" (file contents as value)
PFSENSE_USERNAME=
PFSENSE_PASSWORD=
# Optional SNMP collection (requires pysnmp in discovery extras):
PFSENSE_USE_SNMP=false
PFSENSE_SNMP_COMMUNITY=public

# SNMP/LLDP collector (generic, non-UniFi gear). Comma-separated host[:community].
# Needs the 'discovery' extra: pip install 'argus-netbox[discovery]'
SNMP_TARGETS=
SNMP_COMMUNITY=public
SNMP_PORT=161
SNMP_TIMEOUT=1.0
SNMP_RETRIES=5
# Optional SNMPv3: setting SNMP_V3_USER switches every target to USM (v2c community suffixes in
# SNMP_TARGETS are then ignored). Security level follows the keys: no auth key = noAuthNoPriv,
# auth only = authNoPriv, auth + priv = authPriv. Mixing v2c and v3 in one scan is unsupported.
SNMP_V3_USER=
SNMP_V3_AUTH_KEY=
SNMP_V3_AUTH_PROTOCOL=sha       # md5|sha|sha224|sha256|sha384|sha512
SNMP_V3_PRIV_KEY=
SNMP_V3_PRIV_PROTOCOL=aes128    # des|aes128|aes192|aes256

# HTTP server (FastAPI, used by the web app)
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Optional API auth: require "Authorization: Bearer <token>" on /api and /webhooks.
# Unset = open (default). When set, the dashboard's nginx forwards it and NetBox
# webhooks must send the matching header.
HTTP_TOKEN=

# Optional NetBox webhook authenticity: verify the X-Hook-Signature HMAC (HMAC-SHA512 of the
# raw body) on POST /webhooks/netbox. Set this to the matching NetBox webhook "secret".
# Unset = no verification (default). Additive to HTTP_TOKEN; both apply when both are set.
NETBOX_WEBHOOK_SECRET=

# Optional scheduled drift discovery (in-process, read-only — no writes/reconcile).
# SCHEDULE_INTERVAL is seconds between cycles; 0/unset disables it (e.g. 300 = 5 min).
# The latest outcome is exposed at GET /api/drift/status.
SCHEDULE_INTERVAL=0
SCHEDULE_COLLECTOR=unifi
# Optional: also POST a Slack-compatible {"text": ...} alert when drift is detected.
ALERT_WEBHOOK_URL=

# Optional shared-instance soft isolation (ADR-0007): find-or-create this NetBox tenant and stamp
# it on objects reconcile creates (devices, IP addresses, auto-created sites). Create-only — an
# existing object's tenant is never touched. Unset = single-tenant (default). Soft only: shared
# catalog objects, components, and cables carry no tenant; prefixes are deferred.
NETBOX_TENANT=

# --- Docker workload discovery (ADR-0015) ---
# "name=target" pairs; target is any SSH destination, "local" runs without SSH.
DOCKER_HOSTS=
# Per-host docker binary overrides, same shape (QNAP keeps it off PATH):
#   thor=/share/ZFS530_DATA/.qpkg/container-station/bin/docker
DOCKER_BINARIES=
DOCKER_SSH_TIMEOUT=10
